/* =========================================
   EL-HAMD REAL ESTATE
   PREMIUM PORTFOLIO
========================================= */

:root {

    --white: #a40101;
    --black:#140000;
    --dark: #370000;
    --white: #ffffff;
    --gray:#210000;
    --gold: #c9a96e;

    --transition: 0.8s cubic-bezier(.16,1,.3,1);
}


/* RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--black);
    color: var(--white);
    font-family: "Cairo", sans-serif;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    width: 100%;
    display: block;
}


/* =========================================
   LOADER
========================================= */

.loader {
    position: fixed;
    inset: 0;
    background: var(--black);
    z-index: 9999;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    transition: 1s;
}

.loader.hide {
    opacity: 0;
    visibility: hidden;
}

.loader-logo {
    font-family: "Playfair Display";
    font-size: 42px;
    letter-spacing: 12px;
}

.loader-line {
    width: 0;
    height: 20px;
    background: var(--gold);
    margin-top: 20px;

    animation: loaderLine 1.5s forwards;
}

@keyframes loaderLine {
    to {
        width: 480px;
    }
}


/* =========================================
   NAVBAR
========================================= */

.navbar {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;
    height: 90px;

    padding: 0 6%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    z-index: 1000;

    transition: .5s;
}

.navbar.scrolled {
    height: 70px;
    background: rgba(52, 0, 0, 0.9);
    backdrop-filter: blur(15px);
}

.logo {
    font-family: "Playfair Display";
    font-size: 25px;
    letter-spacing: 5px;
}

.logo span {
    color: var(--gold);
}

.navbar nav {
    display: flex;
    gap: 35px;
}

.navbar nav a {
    font-size: 13px;
    color: #ddd;
    position: relative;
}

.navbar nav a::after {
    content: "";

    position: absolute;
    bottom: -8px;
    right: 0;

    width: 0;
    height: 1px;

    background: var(--gold);

    transition: .4s;
}

.navbar nav a:hover::after {
    width: 100%;
}


/* MOBILE MENU */

.menu-btn {
    display: none;
    background: none;
    border: none;
}

.menu-btn span {
    display: block;
    width: 28px;
    height: 1px;
    background: white;
    margin: 7px;
}


/* =========================================
   HERO
========================================= */

.hero {
    height: 100vh;
    min-height: 700px;

    position: relative;

    display: flex;
    align-items: center;

    overflow: hidden;
}

.hero-bg {
    position: absolute;
    inset: -5%;

    background:
        url("images/hero.jpg")
        center/cover no-repeat;

    transform: scale(1.08);

    animation: heroZoom 2s forwards;
}

@keyframes heroZoom {
    to {
        transform: scale(1);
    }
}

.hero-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.85),
            rgba(0,0,0,.3),
            rgba(0,0,0,.65)
        );
}

.hero-content {
    position: relative;
    z-index: 2;

    width: 750px;

    margin-right: 10%;

    animation: heroText 1.4s .4s both;
}

@keyframes heroText {

    from {
        opacity: 0;
        transform: translateY(80px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.small-title,
.section-label {

    color: var(--gold);

    font-size: 12px;

    letter-spacing: 4px;

    margin-bottom: 25px;
}

.hero h1 {
    font-family: "Playfair Display", "Cairo";
    font-size: clamp(50px, 6vw, 90px);
    line-height: 1.15;
    font-weight: 500;
}

.hero h1 span {
    color: var(--gold);
}

.hero-description {
    color: #ddd;

    max-width: 520px;

    margin: 30px 0;

    line-height: 2;
}

.hero-buttons {
    display: flex;
    gap: 15px;
}

.btn {
    padding: 15px 28px;

    border: 1px solid rgba(255,255,255,.4);

    transition: .5s;

    font-size: 13px;
}

.btn-main {
    background: var(--gold);
    border-color: var(--gold);
    color: black;
}

.btn-main:hover {
    background: white;
    border-color: white;
    transform: translateY(-5px);
}

.btn-outline:hover {
    background: white;
    color: black;
    transform: translateY(-5px);
}

.btn span {
    margin-right: 15px;
}


/* HERO NUMBER */

.hero-number {

    position: absolute;

    left: 7%;
    bottom: 10%;

    display: flex;
    align-items: center;
    gap: 15px;

    color: #aaa;
    font-size: 12px;
}

.hero-number div {
    width: 100px;
    height: 1px;
    background: #555;
}


/* SCROLL */

.scroll-down {

    position: absolute;

    right: 5%;
    bottom: 8%;

    display: flex;
    align-items: center;
    gap: 15px;

    transform: rotate(90deg);

    font-size: 10px;
    letter-spacing: 3px;
}

.scroll-line {
    width: 60px;
    height: 1px;
    background: white;
}


/* =========================================
   SECTIONS
========================================= */

.section {
    position: relative;
    padding: 140px 8%;
}

.section-number {
    position: absolute;

    top: 80px;
    left: 5%;

    color: #222;

    font-size: 100px;

    font-family: "Playfair Display";
}


/* =========================================
   ABOUT
========================================= */

.about {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 100px;

    align-items: center;

    background:#140000;
}

.about-image {

    height: 650px;

    overflow: hidden;
}

.about-image img {

    height: 100%;
    object-fit: cover;

    transition: 1.2s;
}

.about-image:hover img {
    transform: scale(1.08);
}

.about-content {
    max-width: 600px;
}

.about-content h2,
.projects h2,
.numbers h2,
.vision h2,
.contact h2 {

    font-family: "Playfair Display", "Cairo";

    font-size: clamp(45px,5vw,75px);

    line-height: 1.2;

    font-weight: 500;

    margin-bottom: 35px;
}

.about-content h2 span,
.projects h2 span,
.numbers h2 span,
.vision h2 span,
.contact h2 span {

    color: var(--gold);
}

.about-content p {

    color: #999;

    line-height: 2;

    margin-bottom: 20px;
}

.text-link {

    display: inline-flex;

    gap: 20px;

    margin-top: 25px;

    border-bottom: 1px solid var(--gold);

    padding-bottom: 8px;

    color: var(--gold);

    transition: .4s;
}

.text-link:hover {
    gap: 30px;
}


/* =========================================
   PROJECTS
========================================= */

.projects {
    background: var(--black);
}

.projects-header {

    display: flex;

    justify-content: space-between;

    align-items: end;

    margin-bottom: 70px;
}

.projects-header > p {

    max-width: 350px;

    color: #888;

    line-height: 2;
}

.project-grid {

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 25px;
}

.project-card {
    cursor: pointer;
}

.project-image {

    position: relative;

    height: 550px;

    overflow: hidden;
}

.project-image img {

    height: 100%;

    object-fit: cover;

    transition:
        transform 1s cubic-bezier(.16,1,.3,1);
}

.project-card:hover img {
    transform: scale(1.12);
}

.project-overlay {

    position: absolute;

    inset: 0;

    background: rgba(0,0,0,.5);

    opacity: 0;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 20px;

    transition: .6s;
}

.project-card:hover .project-overlay {
    opacity: 1;
}

.arrow {

    width: 65px;
    height: 65px;

    border: 1px solid white;

    border-radius: 50%;

    display: grid;
    place-items: center;

    font-size: 25px;

    transition: .5s;
}

.project-card:hover .arrow {
    background: white;
    color: black;
    transform: rotate(45deg);
}

.project-info {

    padding: 25px 5px;

    display: flex;

    justify-content: space-between;

    border-bottom: 1px solid #333;
}

.project-info h3 {

    font-family: "Playfair Display";

    font-size: 22px;

    margin-top: 8px;
}

.project-type {

    font-size: 9px;

    color: var(--gold);

    letter-spacing: 2px;
}


/* =========================================
   NUMBERS
========================================= */

.numbers {

    min-height: 650px;

    display: flex;

    align-items: center;

    overflow: hidden;
}

.numbers-bg {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            rgba(0,0,0,.72),
            rgba(0,0,0,.85)
        ),
        url("images/hero.jpg")
        center/cover;

    background-attachment: fixed;

    opacity: .8;
}

.numbers-content {

    position: relative;

    width: 100%;

    text-align: center;
}

.stats {

    display: grid;

    grid-template-columns: repeat(4,1fr);

    margin-top: 80px;
}

.stat {

    border-left: 1px solid #444;

    padding: 20px;
}

.stat:last-child {
    border-left: none;
}

.stat strong {

    display: block;

    font-family: "Playfair Display";

    font-size: 70px;

    color: var(--gold);
}

.stat span {
    color: #aaa;
}


/* =========================================
   VISION
========================================= */

.vision {

    min-height: 650px;

    display: flex;

    align-items: center;

    background:#140000;
}

.vision-content {
    max-width: 800px;
}

.vision-content > p:last-child {

    color: #888;

    line-height: 2.5;

    max-width: 500px;
}

.vision-number {

    position: absolute;

    left: 7%;

    font-family: "Playfair Display";

    font-size: 300px;

    color: #151515;

    z-index: 0;
}


/* =========================================
   CONTACT
========================================= */

.contact {

    min-height: 700px;

    display: flex;

    align-items: center;

    background: var(--black);
}

.contact-content {
    position: relative;
    z-index: 2;
}

.contact-content > p:nth-of-type(2) {

    color: #888;

    max-width: 450px;

    line-height: 2;

    margin-bottom: 35px;
}

.contact-btn {

    display: inline-flex;

    align-items: center;

    gap: 25px;

    padding: 18px 30px;

    background: var(--gold);

    color: black;

    transition: .5s;
}

.contact-btn:hover {

    background: white;

    transform: translateY(-5px);
}

.contact-decoration {

    position: absolute;

    left: 10%;

    font-family: "Playfair Display";

    font-size: 500px;

    color: #111;

    line-height: 1;
}


/* =========================================
   FOOTER
========================================= */

footer {

    min-height: 120px;

    border-top: 1px solid #222;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 8%;

    color: #666;

    font-size: 12px;
}

.footer-logo {

    color: white;

    font-family: "Playfair Display";

    letter-spacing: 5px;

    font-size: 20px;
}


/* =========================================
   SCROLL REVEAL
========================================= */

.reveal {

    opacity: 0;

    transform: translateY(70px);

    transition:
        opacity 1s var(--transition),
        transform 1s var(--transition);
}

.reveal.active {

    opacity: 1;

    transform: translateY(0);
}

.reveal-image {

    clip-path: inset(0 100% 0 0);

    transition: clip-path 1.5s var(--transition);
}

.reveal-image.active {

    clip-path: inset(0 0 0 0);
}


/* =========================================
   MOBILE
========================================= */

@media(max-width: 900px) {

    .navbar nav {
        display: none;
    }

    .menu-btn {
        display: block;
    }

    .hero-content {

        width: auto;

        margin: 0 8%;
    }

    .hero h1 {
        font-size: 50px;
    }

    .about {

        grid-template-columns: 1fr;

        gap: 50px;
    }

    .about-image {
        height: 450px;
    }

    .project-grid {

        grid-template-columns: 1fr;

    }

    .project-image {
        height: 500px;
    }

    .projects-header {
        flex-direction: column;

        align-items: start;

        gap: 25px;
    }

    .stats {

        grid-template-columns: repeat(2,1fr);

        gap: 20px;
    }

    .stat {

        border: none;
    }

    footer {

        flex-direction: column;

        gap: 15px;

        justify-content: center;
    }

}

@media(max-width: 500px) {

    .section {
        padding: 100px 7%;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-description {
        font-size: 13px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: start;
    }

    .about-image {
        height: 350px;
    }

    .stats strong {
        font-size: 50px;
    }

}
